# Container paths. For a native installation, use paths on your machine instead.
SOURCE_DIR=/library/source
# Non-empty paths automatically enable these destinations.
# CONVERTED_DIR=/library/converted
# QUARANTINE_DIR=/library/quarantine
DB_PATH=/config/cbzxl.sqlite3
SCRATCH_DIR=/work
HOST=127.0.0.1
PORT=5000
# API_TOKEN=
CPU_LIMIT=2
MEMORY_LIMIT_MB=2048
ENCODER_EFFORT=7
ARCHIVE_STABLE_SECONDS=2
# Docker Compose mounts this host directory at /library.
LIBRARY_ROOT=./library
CONFIG_DIR=./data
WORK_DIR=./work
# Set these to the owner of the library and data directories.
PUID=1000
PGID=1000
CONTAINER_MEMORY=3g
