FROM node:24.22.3-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0
WORKDIR /app
COPY package.json ./
COPY src/config.ts src/database.ts src/files.ts src/migrate.ts src/migration-cli.ts src/schema.sql ./src/
ENV DB_PATH=/config/cbzxl.sqlite3 SOURCE_DIR=/library
USER node
ENTRYPOINT ["node", "src/migration-cli.ts"]
